         <pdf:Producer>Acrobat Distiller 9.0.0 (Windows)</pdf:Producer>
         <pdf:Keywords>Application mapping, mapping techniques, network-on-chip, system on chip, optimisation</pdf:Keywords>
         <xmpMM:DocumentID>uuid:dc45defd-fee0-443f-b5ac-e8ddfa856466</xmpMM:DocumentID>
